# TP=2 rank 1 on the reference pair (edgexpert02): copy to /work/rank.env on that host and put your own values.
# 参照機の対のTP=2 rank 1（edgexpert02）。そのホストの /work/rank.env にコピーし、自分の値に直す。
# The values are those of the 2026-10-02 measurements; 1.x uses the same link, HCA and GID.
# Sourced by serve.sh with `set -a; . file`.
MASTER=10.41.12.1                               # rank 0's address on the direct link
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0        # 2 rails, the 2.x default (1 rail: rocep1s0f0 alone)
NCCL_IB_GID_INDEX=3                             # the RoCE v2 entry on these ports
NCCL_SOCKET_IFNAME=enp1s0f0np0              # bootstrap over the link's interface
